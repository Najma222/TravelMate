# Copy to .env and replace every placeholder. Never commit .env.

# --- PostgreSQL (compose builds DATABASE_URL from these) ---
POSTGRES_USER=travelmate
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=travelmate

# --- Flask backend ---
APP_ENV=production
# 32+ random chars, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Shared secret for n8n <-> Flask (X-Webhook-Secret). Use a long random value.
INTERNAL_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Comma-separated list of frontend origins allowed to call unsafe methods (D12).
ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=/app/uploads
# Set to false only for plain-HTTP local runs with APP_ENV=production.
SESSION_COOKIE_SECURE=true
# n8n webhook that starts itinerary generation (Docker service name).
N8N_TRIP_WEBHOOK_URL=http://n8n:5678/webhook/trip-generate
N8N_TIMEOUT_SECONDS=10
GENERATION_TIMEOUT_MINUTES=10
SEED_DISCOVER_ON_START=true
# DATABASE_URL is set by docker-compose; set it yourself when running outside Docker:
# DATABASE_URL=postgresql+psycopg2://travelmate:change-me@localhost:5432/travelmate

# --- n8n ---
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-encryption-key
GEOAPIFY_API_KEY=
GEMINI_API_KEY=
ORS_API_KEY=
